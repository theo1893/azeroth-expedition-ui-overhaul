.DS_Store
.idea/
.vscode/
*.tmp
*.bak
*.swp
*.pyc
__pycache__/
.pytest_cache/
build/
dist/
release/
archive/
*.zip
*.log

# Generated material is local intermediate evidence and never enters Git. Delete the
# owning component's generated tree after acceptance or abandonment.
/generated/

# A rare cross-device handoff may intentionally track only its minimal candidate and
# metadata. Transaction scratch directories remain local.
/handoff/.stage-*/
/handoff/.backup-*/
